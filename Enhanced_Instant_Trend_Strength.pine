//@version=6
indicator("⚡ Instant Trend Strength v2", shorttitle="ITS v2", overlay=false)

// ====================================
// Inputs
// ====================================
length = input.int(14, "Lookback Period", minval=2)
rangeDetectionLength = input.int(20, "Range Detection Period", minval=5)
smoothing = input.int(5, "Smoothing", minval=1)
useSmoothing = input.bool(true, "Apply Smoothing")

// ====================================
// 1. Efficiency Ratio - قدرت روند
// ====================================
priceChange = close - close[length]
absPriceChange = math.abs(priceChange)
totalMovement = math.sum(math.abs(close - close[1]), length)

efficiency = totalMovement != 0 
     ? (absPriceChange / totalMovement) * 100
     : 0.0

// ====================================
// 2. Range Detection - تشخیص رنج
// ====================================
highestPrice = ta.highest(high, rangeDetectionLength)
lowestPrice = ta.lowest(low, rangeDetectionLength)
priceRange = highestPrice - lowestPrice

atr = ta.atr(length)
avgAtr = ta.sma(atr, length)

rangeRatio = avgAtr != 0 
     ? priceRange / (avgAtr * rangeDetectionLength)
     : 1.0

rangeStrength = 1.0 - math.min(rangeRatio, 1.0)

// ====================================
// 3. ادغام قدرت روند و تشخیص رنج
// ====================================
finalStrength = efficiency * (1.0 - rangeStrength)

finalStrengthClamped = math.max(0.0, math.min(100.0, finalStrength))

finalStrengthSmoothed = useSmoothing 
     ? ta.sma(finalStrengthClamped, smoothing)
     : finalStrengthClamped

// ====================================
// Direction - جهت روند
// ====================================
isBullish = close > close[length]
isBearish = close < close[length]

// ====================================
// Colors - رنگ بر اساس جهت
// ====================================
lineColor = 
     isBullish
          ? color.new(#00FF00, 0)
          : isBearish
               ? color.new(#FF0000, 0)
               : color.new(#808080, 50)

// ====================================
// Plotting
// ====================================
plot(
     finalStrengthSmoothed,
     title="Trend Strength",
     color=lineColor,
     linewidth=2
)

// Reference Lines
hline(0, "Zero", color=color.gray, linestyle=hline.style_solid, linewidth=1)
hline(50, "Mid", color=color.gray, linestyle=hline.style_dotted, linewidth=1)
hline(100, "Max", color=color.gray, linestyle=hline.style_dashed, linewidth=1)

// ====================================
// Alerts
// ====================================
strongBullish = finalStrengthSmoothed >= 70 and isBullish
strongBearish = finalStrengthSmoothed >= 70 and isBearish
rangeDetected = rangeStrength > 0.6

alertcondition(strongBullish, title="🟢 Strong Bullish Trend", message="Strong uptrend detected!")
alertcondition(strongBearish, title="🔴 Strong Bearish Trend", message="Strong downtrend detected!")
alertcondition(rangeDetected, title="📊 Range Detected", message="Range zone detected - trend strength near zero!")
