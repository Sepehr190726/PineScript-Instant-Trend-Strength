//@version=6
indicator("⚡ Instant Trend Strength - Pure", shorttitle="ITS", overlay=false)

// ====================================
// Inputs
// ====================================
length = input.int(14, "Lookback Period", minval=2)
smoothing = input.int(5, "Smoothing", minval=1)
useSmoothing = input.bool(true, "Apply Smoothing")

// ====================================
// Core Calculation
// ====================================

// 1. Price Movement
priceChange = close - close[length]
absPriceChange = math.abs(priceChange)

// 2. Total Movement (Sum of all movements in period)
totalMovement = math.sum(math.abs(close - close[1]), length)

// 3. Efficiency Ratio (Net Movement / Total Movement)
// This tells us how directional the price is
efficiency = totalMovement != 0 
     ? (absPriceChange / totalMovement) * 100
     : 0.0

// 4. Volatility Adjustment (ATR based)
atr = ta.atr(length)
avgAtr = ta.sma(atr, length)

volatilityFactor = avgAtr != 0 
     ? atr / avgAtr
     : 1.0

// Scale volatility to boost signal in trending markets
volatilityBoost = math.min(volatilityFactor, 1.5)

// ====================================
// Final Strength (0-100)
// ====================================
trendStrength = efficiency * volatilityBoost

// Clamp to 0-100
trendStrengthClamped = math.max(0.0, math.min(100.0, trendStrength))

// Apply smoothing
trendStrengthFinal = useSmoothing 
     ? ta.sma(trendStrengthClamped, smoothing)
     : trendStrengthClamped

// ====================================
// Direction Detection
// ====================================
isBullish = close > close[length]
isBearish = close < close[length]
isNeutral = close == close[length]

// ====================================
// Colors
// ====================================
lineColor = 
     isBullish
          ? color.new(#00FF00, 0)
          : isBearish
               ? color.new(#FF0000, 0)
               : color.new(#808080, 50)

// ====================================
// Plotting
// ====================================
plot(
     trendStrengthFinal,
     title="Trend Strength",
     color=lineColor,
     linewidth=2
)

// Reference Lines
hline(0, "Zero", color=color.gray, linestyle=hline.style_solid, linewidth=1)
hline(50, "Mid", color=color.gray, linestyle=hline.style_dotted, linewidth=1)
hline(100, "Max", color=color.gray, linestyle=hline.style_dashed, linewidth=1)

// Fill between 0 and line
fill(plot(trendStrengthFinal), plot(0), color=lineColor, title="Strength Fill")

// ====================================
// Alerts
// ====================================
strongBullish = trendStrengthFinal >= 70 and isBullish
strongBearish = trendStrengthFinal >= 70 and isBearish
weakTrend = trendStrengthFinal < 30

alertcondition(strongBullish, title="🟢 Strong Bullish Trend", message="Strong uptrend detected!")
alertcondition(strongBearish, title="🔴 Strong Bearish Trend", message="Strong downtrend detected!")
alertcondition(weakTrend, title="⚪ Weak / Range", message="Range detected - weak trend!")
